---
import { Image } from "astro:assets";
import Logo from "@/components/assets/Logo.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import { shopCategories, collections, products } from "@/data/tara";
import { getTaraImage } from "@/data/images";

const featuredLinks = [
  { label: "New Arrivals", href: "/shop" },
  { label: "Fall Chapter One", href: "/collections/fall-chapter-one" },
  { label: "Summer Chapter Two", href: "/collections/summer-chapter-two" },
  { label: "Gift Cards", href: "/gift-cards" },
];

const discoverLinks = [
  { label: "Our Story", href: "/collections" },
  { label: "Our Shops", href: "/shops" },
  { label: "Journal", href: "/journal" },
  { label: "Gift Cards", href: "/gift-cards" },
];

const assistanceLinks = [
  { label: "Track Order", href: "/track-order" },
  { label: "Returns", href: "/returns" },
  { label: "FAQ", href: "/faq" },
  { label: "Contact", href: "/contact" },
  { label: "Gift Card Balance", href: "/gift-cards" },
];

const megaLifestyle = getTaraImage("hero-dresses");
const featuredProduct = products[0];
---

<header
  class="sticky top-0 z-50 bg-cream/95 backdrop-blur-[2px] border-b border-taupe/60"
>
  <Wrapper variant="wide" class="py-4 lg:py-5">
    <nav
      class="grid grid-cols-[1fr_auto_1fr] items-center text-charcoal"
      aria-label="Primary"
    >
      <!-- Left -->
      <div class="hidden lg:flex items-center gap-5 xl:gap-7">
        <a
          href="/collections"
          class="text-[11px] tracking-[0.22em] uppercase hover:opacity-60 transition-opacity"
        >
          New
        </a>

        <!-- SHOP mega -->
        <div class="relative group/shop">
          <a
            href="/shop"
            class="text-[11px] tracking-[0.22em] uppercase hover:opacity-60 transition-opacity"
          >
            Shop
          </a>
          <div
            class="invisible opacity-0 pointer-events-none group-hover/shop:visible group-hover/shop:opacity-100 group-hover/shop:pointer-events-auto transition-opacity duration-200 absolute left-0 top-full pt-4 z-50"
          >
            <div
              class="bg-cream border border-taupe shadow-sm w-[min(42rem,90vw)] p-6 grid grid-cols-[1fr_1fr_11rem] gap-8"
            >
              <div>
                <p
                  class="text-[10px] tracking-[0.2em] uppercase text-charcoal/50 mb-3"
                >
                  Clothing
                </p>
                <ul class="flex flex-col gap-2">
                  {
                    shopCategories.map((cat) => (
                      <li>
                        <a
                          href={cat.href}
                          class="text-[12px] tracking-[0.16em] uppercase hover:opacity-60 transition-opacity"
                        >
                          {cat.label}
                        </a>
                      </li>
                    ))
                  }
                </ul>
              </div>
              <div>
                <p
                  class="text-[10px] tracking-[0.2em] uppercase text-charcoal/50 mb-3"
                >
                  Featured
                </p>
                <ul class="flex flex-col gap-2">
                  {
                    featuredLinks.map((link) => (
                      <li>
                        <a
                          href={link.href}
                          class="text-[12px] tracking-[0.16em] uppercase hover:opacity-60 transition-opacity"
                        >
                          {link.label}
                        </a>
                      </li>
                    ))
                  }
                </ul>
              </div>
              <a href={`/products/${featuredProduct.slug}`} class="group/img block">
                <div class="overflow-hidden aspect-[3/4] bg-taupe/40">
                  <Image
                    src={megaLifestyle}
                    alt={featuredProduct.name}
                    class="size-full object-cover tara-img-zoom"
                    widths={[240, 360]}
                    sizes="11rem"
                    loading="lazy"
                  />
                </div>
                <p
                  class="mt-2 text-[10px] tracking-[0.16em] uppercase text-charcoal/70"
                >
                  {featuredProduct.name}
                </p>
              </a>
            </div>
          </div>
        </div>

        <!-- COLLECTIONS mega -->
        <div class="relative group/collections">
          <a
            href="/collections"
            class="text-[11px] tracking-[0.22em] uppercase hover:opacity-60 transition-opacity"
          >
            Collections
          </a>
          <div
            class="invisible opacity-0 pointer-events-none group-hover/collections:visible group-hover/collections:opacity-100 group-hover/collections:pointer-events-auto transition-opacity duration-200 absolute left-0 top-full pt-4 z-50"
          >
            <div class="bg-cream border border-taupe shadow-sm min-w-[16rem] py-4 px-5">
              <p
                class="text-[10px] tracking-[0.2em] uppercase text-charcoal/50 mb-3"
              >
                Seasonal Chapters
              </p>
              <ul class="flex flex-col gap-2">
                {
                  collections.map((c) => (
                    <li>
                      <a
                        href={`/collections/${c.slug}`}
                        class="text-[12px] tracking-[0.16em] uppercase hover:opacity-60 transition-opacity"
                      >
                        {c.title}
                      </a>
                    </li>
                  ))
                }
                <li class="pt-2 mt-1 border-t border-taupe">
                  <a
                    href="/collections"
                    class="text-[12px] tracking-[0.16em] uppercase hover:opacity-60 transition-opacity"
                  >
                    View All
                  </a>
                </li>
              </ul>
            </div>
          </div>
        </div>

        <!-- DISCOVER mega -->
        <div class="relative group/discover">
          <a
            href="/shops"
            class="text-[11px] tracking-[0.22em] uppercase hover:opacity-60 transition-opacity"
          >
            Discover
          </a>
          <div
            class="invisible opacity-0 pointer-events-none group-hover/discover:visible group-hover/discover:opacity-100 group-hover/discover:pointer-events-auto transition-opacity duration-200 absolute left-0 top-full pt-4 z-50"
          >
            <div class="bg-cream border border-taupe shadow-sm min-w-[14rem] py-4 px-5">
              <ul class="flex flex-col gap-2">
                {
                  discoverLinks.map((link) => (
                    <li>
                      <a
                        href={link.href}
                        class="text-[12px] tracking-[0.16em] uppercase hover:opacity-60 transition-opacity"
                      >
                        {link.label}
                      </a>
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
        </div>
      </div>

      <!-- Logo -->
      <a href="/" class="justify-self-start lg:justify-self-center">
        <span class="sr-only">TARA home</span>
        <Logo
          class="text-2xl md:text-3xl lg:text-[2.35rem] font-medium tracking-[0.35em] font-display uppercase text-charcoal"
        />
      </a>

      <!-- Right -->
      <div class="hidden lg:flex items-center gap-5 xl:gap-7 justify-self-end">
        <a
          href="/account"
          class="text-[11px] tracking-[0.22em] uppercase hover:opacity-60 transition-opacity"
        >
          Account
        </a>
        <button
          type="button"
          id="search-toggle"
          class="text-[11px] tracking-[0.22em] uppercase hover:opacity-60 transition-opacity"
          aria-label="Search"
          aria-expanded="false"
          aria-controls="search-overlay"
        >
          Search
        </button>

        <!-- ASSISTANCE mega -->
        <div class="relative group/assist">
          <a
            href="/assistance"
            class="text-[11px] tracking-[0.22em] uppercase hover:opacity-60 transition-opacity"
          >
            Assistance
          </a>
          <div
            class="invisible opacity-0 pointer-events-none group-hover/assist:visible group-hover/assist:opacity-100 group-hover/assist:pointer-events-auto transition-opacity duration-200 absolute right-0 top-full pt-4 z-50"
          >
            <div class="bg-cream border border-taupe shadow-sm min-w-[14rem] py-4 px-5">
              <ul class="flex flex-col gap-2">
                {
                  assistanceLinks.map((link) => (
                    <li>
                      <a
                        href={link.href}
                        class="text-[12px] tracking-[0.16em] uppercase hover:opacity-60 transition-opacity"
                      >
                        {link.label}
                      </a>
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
        </div>

        <button
          type="button"
          id="bag-toggle"
          class="text-[11px] tracking-[0.22em] uppercase hover:opacity-60 transition-opacity"
          aria-label="Open bag"
          data-bag-count
        >
          Bag (0)
        </button>
      </div>

      <div class="lg:hidden justify-self-end flex items-center gap-4">
        <button
          type="button"
          id="bag-toggle-mobile"
          class="text-[11px] tracking-[0.22em] uppercase"
          aria-label="Open bag"
          data-bag-count
        >
          Bag (0)
        </button>
        <button
          id="mobile-menu-toggle"
          type="button"
          class="text-[11px] tracking-[0.22em] uppercase text-charcoal"
          aria-label="Toggle menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          Menu
        </button>
      </div>
    </nav>
  </Wrapper>
</header>

<!-- Search overlay -->
<div
  id="search-overlay"
  class="hidden fixed inset-0 z-[60] bg-cream/98 backdrop-blur-sm"
  role="dialog"
  aria-modal="true"
  aria-label="Search"
>
  <Wrapper variant="wide" class="pt-24 pb-12">
    <button
      type="button"
      id="search-close"
      class="absolute top-6 right-6 text-[11px] tracking-[0.22em] uppercase"
    >
      Close
    </button>
    <form action="/shop" method="get" class="max-w-xl mx-auto">
      <label class="sr-only" for="site-search">Search the shop</label>
      <input
        id="site-search"
        name="q"
        type="search"
        placeholder="Search dresses, knits, shops…"
        class="w-full bg-transparent border-0 border-b border-charcoal/40 px-0 py-4 text-2xl font-script text-charcoal placeholder:text-charcoal/35 focus:border-charcoal focus:ring-0"
        autocomplete="off"
      />
      <p class="mt-4 text-[11px] tracking-[0.18em] uppercase text-charcoal/50">
        Press enter to browse the shop
      </p>
    </form>
  </Wrapper>
</div>

<nav
  id="mobile-menu"
  class="hidden lg:hidden fixed inset-x-0 bottom-0 z-40 bg-cream border-t border-taupe overflow-y-auto"
  style="top: 0"
  aria-label="Mobile"
>
  <Wrapper variant="wide" class="py-6 pt-20 flex flex-col gap-5">
    <button
      id="mobile-menu-close"
      type="button"
      class="absolute top-5 right-6 text-[11px] tracking-[0.22em] uppercase"
    >
      Close
    </button>
    <a href="/collections" class="text-2xl font-script text-charcoal">New</a>
    <a href="/shop" class="text-2xl font-script text-charcoal">Shop</a>
    <div class="pl-2 flex flex-col gap-2 -mt-2">
      {
        shopCategories.map((cat) => (
          <a
            href={cat.href}
            class="text-[12px] tracking-[0.18em] uppercase text-charcoal/80"
          >
            {cat.label}
          </a>
        ))
      }
    </div>
    <a href="/collections" class="text-2xl font-script text-charcoal"
      >Collections</a
    >
    <a href="/shops" class="text-2xl font-script text-charcoal">Discover</a>
    <a href="/account" class="text-2xl font-script text-charcoal">Account</a>
    <a href="/assistance" class="text-2xl font-script text-charcoal"
      >Assistance</a
    >
    <button
      type="button"
      id="search-toggle-mobile"
      class="text-left text-2xl font-script text-charcoal"
    >
      Search
    </button>
  </Wrapper>
</nav>

<script>
  import { getCartCount, onCartChange } from "@/scripts/cart";

  const menuToggle = document.getElementById("mobile-menu-toggle");
  const menuClose = document.getElementById("mobile-menu-close");
  const mobileMenu = document.getElementById("mobile-menu");
  const headerEl = document.querySelector("header");
  const searchOverlay = document.getElementById("search-overlay");
  const searchToggle = document.getElementById("search-toggle");
  const searchToggleMobile = document.getElementById("search-toggle-mobile");
  const searchClose = document.getElementById("search-close");
  const bagToggle = document.getElementById("bag-toggle");
  const bagToggleMobile = document.getElementById("bag-toggle-mobile");

  function positionMobileMenu() {
    if (!mobileMenu || !headerEl) return;
    const h = headerEl.getBoundingClientRect().height;
    mobileMenu.style.top = `${h}px`;
  }

  function setMenuOpen(open: boolean) {
    mobileMenu?.classList.toggle("hidden", !open);
    menuToggle?.setAttribute("aria-expanded", String(open));
    document.body.classList.toggle("overflow-hidden", open);
  }

  function setSearchOpen(open: boolean) {
    searchOverlay?.classList.toggle("hidden", !open);
    searchToggle?.setAttribute("aria-expanded", String(open));
    document.body.classList.toggle("overflow-hidden", open);
    if (open) {
      setMenuOpen(false);
      document.getElementById("site-search")?.focus();
    }
  }

  function updateBagCounts() {
    const count = getCartCount();
    document.querySelectorAll("[data-bag-count]").forEach((el) => {
      el.textContent = `Bag (${count})`;
    });
  }

  positionMobileMenu();
  window.addEventListener("resize", positionMobileMenu);
  menuToggle?.addEventListener("click", () => {
    const open = mobileMenu?.classList.contains("hidden");
    setMenuOpen(!!open);
  });
  menuClose?.addEventListener("click", () => setMenuOpen(false));
  mobileMenu?.querySelectorAll("a").forEach((a) => {
    a.addEventListener("click", () => setMenuOpen(false));
  });

  searchToggle?.addEventListener("click", () => setSearchOpen(true));
  searchToggleMobile?.addEventListener("click", () => setSearchOpen(true));
  searchClose?.addEventListener("click", () => setSearchOpen(false));
  searchOverlay?.addEventListener("click", (e) => {
    if (e.target === searchOverlay) setSearchOpen(false);
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") setSearchOpen(false);
  });

  function openCart() {
    document.dispatchEvent(new CustomEvent("tara:cart-open"));
  }
  bagToggle?.addEventListener("click", openCart);
  bagToggleMobile?.addEventListener("click", openCart);

  updateBagCounts();
  onCartChange(updateBagCounts);
</script>
