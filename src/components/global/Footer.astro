---
// Assets
import { Image } from "astro:assets";
import intro5 from "@/images/assets/intro5.png";
// Assets
import Symbol from "@/components/assets/Symbol.astro";
import { getCollection } from "astro:content";

const people = await getCollection("people");
const bride = people.find((p) => p.data.role.toLowerCase().includes("bride"));
const groom = people.find((p) => p.data.role.toLowerCase().includes("groom"));
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
---

<footer>
  <Wrapper variant="wide" class="py-12 ">
    <div class="relative overflow-hidden h-[calc(100dvh-4rem)]">
      <Image
        src={intro5}
        alt="intro5"
        width="1440"
        height="1193"
        loading="eager"
        decoding="async"
        class="size-full object-cover object-top saturate-50"
      />
      <!-- Overlay with title and subtitle -->
      <div
        class="absolute inset-0 flex flex-col pt-42 items-center text-center justify-center bg-black/30"
      >
        <Symbol class="size-24 lg:size-48 text-white" />
        <Text
          tag="h1"
          variant="display4XL"
          class="font-display text-white uppercase mt-12"
        >
          {bride?.data.name.split(" ")[0] || "Bride"} & {
            groom?.data.name.split(" ")[0] || "Groom"
          }
        </Text>
      </div>
    </div>
  </Wrapper>

</footer>
