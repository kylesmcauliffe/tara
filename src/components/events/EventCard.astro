---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";

const { event } = Astro.props;
const { title, description } = event.data;
const url = "/events/" + event.slug;
---

<article class="relative border-b border-base-200 pb-4">
  <div>
    <Text tag="h3" variant="textXL" class="text-base-900 font-serif">
      {title}
    </Text>
    <Text tag="p" variant="textBase" class="text-base-700 mt-4 text-balance">
      {description}
    </Text>
    <a
      href={url}
      title={`View event: ${title}`}
      aria-label={`View event: ${title}`}
      class="text-base-900 flex mt-12 hover:text-base-600">Read further</a>
  </div>
</article>
