---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";

const { location } = Astro.props;
const { name, address, city, country, notes } = location.data;
---

<article class="relative border-b border-base-200 pb-4">
  <div>
    <Text tag="h3" variant="textXL" class="text-base-900 font-serif">
      {name}
    </Text>
    <Text tag="p" variant="textBase" class="text-base-700 mt-4 text-balance">
      {address}{city && `, ${city}`}{country && `, ${country}`}
    </Text>
    {
      notes && (
        <Text tag="p" variant="textSM" class="text-base-600 mt-2">
          {notes}
        </Text>
      )
    }
  </div>
</article>
