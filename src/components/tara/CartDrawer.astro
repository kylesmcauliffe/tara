---
---

<aside
  id="cart-drawer"
  class="fixed inset-y-0 right-0 z-[70] w-full max-w-md bg-cream border-l border-taupe shadow-xl translate-x-full transition-transform duration-300 ease-out flex flex-col"
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
  aria-label="Shopping bag"
>
  <div class="flex items-center justify-between px-6 py-5 border-b border-taupe">
    <h2 class="font-script text-2xl text-charcoal">Your Bag</h2>
    <button
      type="button"
      id="cart-close"
      class="text-[11px] tracking-[0.22em] uppercase hover:opacity-60 transition-opacity"
    >
      Close
    </button>
  </div>

  <div id="cart-items" class="flex-1 overflow-y-auto px-6 py-6">
    <p id="cart-empty" class="text-center text-charcoal/60 font-serif text-base py-12">
      Your bag is empty.
    </p>
  </div>

  <div class="border-t border-taupe px-6 py-6 space-y-4">
    <div class="flex justify-between text-[12px] tracking-[0.16em] uppercase">
      <span>Subtotal</span>
      <span id="cart-subtotal">$0</span>
    </div>
    <p class="text-[11px] text-charcoal/50 tracking-wide">
      Shipping and taxes calculated at checkout.
    </p>
    <button
      type="button"
      id="cart-checkout"
      class="tara-frame w-full px-6 py-3 text-[11px] tracking-[0.22em] uppercase tara-hover-fade disabled:opacity-40"
      disabled
    >
      Checkout
    </button>
    <p id="cart-checkout-error" class="hidden text-sm text-red-800/80"></p>
  </div>
</aside>

<div
  id="cart-backdrop"
  class="fixed inset-0 z-[65] bg-charcoal/30 opacity-0 pointer-events-none transition-opacity duration-300"
  aria-hidden="true"
>
</div>

<script>
  import {
    getCart,
    getCartTotal,
    updateQty,
    removeFromCart,
    onCartChange,
    CART_OPEN_EVENT,
    type CartItem,
  } from "@/scripts/cart";

  const drawer = document.getElementById("cart-drawer");
  const backdrop = document.getElementById("cart-backdrop");
  const closeBtn = document.getElementById("cart-close");
  const itemsEl = document.getElementById("cart-items");
  const emptyEl = document.getElementById("cart-empty");
  const subtotalEl = document.getElementById("cart-subtotal");
  const checkoutBtn = document.getElementById(
    "cart-checkout",
  ) as HTMLButtonElement | null;
  const errorEl = document.getElementById("cart-checkout-error");

  const imageUrls: Record<string, string> = {};

  function formatPrice(n: number) {
    return `$${n.toLocaleString("en-US")}`;
  }

  function setOpen(open: boolean) {
    if (!drawer || !backdrop) return;
    drawer.classList.toggle("translate-x-full", !open);
    drawer.setAttribute("aria-hidden", String(!open));
    backdrop.classList.toggle("opacity-0", !open);
    backdrop.classList.toggle("pointer-events-none", !open);
    document.body.classList.toggle("overflow-hidden", open);
  }

  function render(items: CartItem[]) {
    if (!itemsEl || !emptyEl || !subtotalEl || !checkoutBtn) return;

    const rows = itemsEl.querySelectorAll("[data-cart-row]");
    rows.forEach((r) => r.remove());

    if (items.length === 0) {
      emptyEl.classList.remove("hidden");
      checkoutBtn.disabled = true;
    } else {
      emptyEl.classList.add("hidden");
      checkoutBtn.disabled = false;
      items.forEach((item) => {
        const row = document.createElement("div");
        row.dataset.cartRow = "true";
        row.className = "flex gap-4 mb-6 pb-6 border-b border-taupe/70 last:border-0";
        const imgSrc = imageUrls[item.imageKey] ?? "";
        row.innerHTML = `
          <div class="w-20 shrink-0 aspect-[3/4] bg-taupe/40 overflow-hidden">
            ${imgSrc ? `<img src="${imgSrc}" alt="" class="size-full object-cover" />` : ""}
          </div>
          <div class="flex-1 min-w-0">
            <p class="font-serif text-base text-charcoal">${item.name}</p>
            <p class="mt-1 text-[11px] tracking-[0.14em] uppercase text-charcoal/55">Size ${item.size}</p>
            <p class="mt-1 text-sm text-charcoal/80">${formatPrice(item.price)}</p>
            <div class="mt-3 flex items-center gap-3">
              <button type="button" data-qty-dec class="w-7 h-7 border border-charcoal/25 text-sm" aria-label="Decrease quantity">−</button>
              <span class="text-sm w-4 text-center">${item.qty}</span>
              <button type="button" data-qty-inc class="w-7 h-7 border border-charcoal/25 text-sm" aria-label="Increase quantity">+</button>
              <button type="button" data-remove class="ml-auto text-[10px] tracking-[0.16em] uppercase text-charcoal/50 hover:text-charcoal">Remove</button>
            </div>
          </div>
        `;
        row.querySelector("[data-qty-dec]")?.addEventListener("click", () => {
          updateQty(item.slug, item.size, item.qty - 1);
        });
        row.querySelector("[data-qty-inc]")?.addEventListener("click", () => {
          updateQty(item.slug, item.size, item.qty + 1);
        });
        row.querySelector("[data-remove]")?.addEventListener("click", () => {
          removeFromCart(item.slug, item.size);
        });
        itemsEl.appendChild(row);
      });
    }

    subtotalEl.textContent = formatPrice(getCartTotal(items));
  }

  closeBtn?.addEventListener("click", () => setOpen(false));
  backdrop?.addEventListener("click", () => setOpen(false));
  document.addEventListener(CART_OPEN_EVENT, () => {
    render(getCart());
    setOpen(true);
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") setOpen(false);
  });

  checkoutBtn?.addEventListener("click", async () => {
    const items = getCart();
    if (!items.length || !checkoutBtn) return;
    checkoutBtn.disabled = true;
    checkoutBtn.textContent = "Redirecting…";
    errorEl?.classList.add("hidden");
    try {
      const res = await fetch("/.netlify/functions/create-checkout", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ items }),
      });
      const data = (await res.json()) as { url?: string; error?: string };
      if (!res.ok || !data.url) {
        throw new Error(data.error || "Unable to start checkout.");
      }
      window.location.href = data.url;
    } catch (err) {
      if (errorEl) {
        errorEl.textContent =
          err instanceof Error ? err.message : "Checkout failed.";
        errorEl.classList.remove("hidden");
      }
      checkoutBtn.disabled = false;
      checkoutBtn.textContent = "Checkout";
    }
  });

  // Hydrate product image URLs from a data island if present
  const island = document.getElementById("cart-image-map");
  if (island?.textContent) {
    try {
      Object.assign(imageUrls, JSON.parse(island.textContent));
    } catch {
      /* ignore */
    }
  }

  render(getCart());
  onCartChange(render);
</script>
