---
interface Props {
  href?: string;
  type?: "button" | "submit";
  class?: string;
  variant?: "solid" | "ghost";
  id?: string;
  "aria-label"?: string;
}

const {
  href,
  type = "button",
  class: className = "",
  variant = "solid",
  id,
  "aria-label": ariaLabel,
} = Astro.props;

const base =
  "tara-framed-btn relative inline-flex items-center justify-center px-8 py-3 text-[11px] tracking-[0.22em] uppercase font-serif text-charcoal tara-frame tara-hover-fade transition-opacity";
const ghost =
  "tara-framed-btn relative inline-flex items-center justify-center px-8 py-3 text-[11px] tracking-[0.22em] uppercase font-serif text-white border border-white/90 bg-white/10 backdrop-blur-[1px] hover:bg-white hover:text-charcoal transition-colors duration-300";
const classes = `${variant === "ghost" ? ghost : base} ${className}`.trim();
---

{
  href ? (
    <a href={href} class={classes} id={id} aria-label={ariaLabel}>
      <svg class="tara-flourish tf-tl" viewBox="0 0 24 24" aria-hidden="true"
        ><path
          d="M2 22 Q2 2 22 2"
          fill="none"
          stroke="currentColor"
          stroke-width="1"></path
        ></svg
      >
      <svg class="tara-flourish tf-tr" viewBox="0 0 24 24" aria-hidden="true"
        ><path
          d="M2 22 Q2 2 22 2"
          fill="none"
          stroke="currentColor"
          stroke-width="1"></path
        ></svg
      >
      <svg class="tara-flourish tf-br" viewBox="0 0 24 24" aria-hidden="true"
        ><path
          d="M2 22 Q2 2 22 2"
          fill="none"
          stroke="currentColor"
          stroke-width="1"></path
        ></svg
      >
      <svg class="tara-flourish tf-bl" viewBox="0 0 24 24" aria-hidden="true"
        ><path
          d="M2 22 Q2 2 22 2"
          fill="none"
          stroke="currentColor"
          stroke-width="1"></path
        ></svg
      >
      <span class="relative z-10"><slot /></span>
    </a>
  ) : (
    <button type={type} class={classes} id={id} aria-label={ariaLabel}>
      <svg class="tara-flourish tf-tl" viewBox="0 0 24 24" aria-hidden="true"
        ><path
          d="M2 22 Q2 2 22 2"
          fill="none"
          stroke="currentColor"
          stroke-width="1"></path
        ></svg
      >
      <svg class="tara-flourish tf-tr" viewBox="0 0 24 24" aria-hidden="true"
        ><path
          d="M2 22 Q2 2 22 2"
          fill="none"
          stroke="currentColor"
          stroke-width="1"></path
        ></svg
      >
      <svg class="tara-flourish tf-br" viewBox="0 0 24 24" aria-hidden="true"
        ><path
          d="M2 22 Q2 2 22 2"
          fill="none"
          stroke="currentColor"
          stroke-width="1"></path
        ></svg
      >
      <svg class="tara-flourish tf-bl" viewBox="0 0 24 24" aria-hidden="true"
        ><path
          d="M2 22 Q2 2 22 2"
          fill="none"
          stroke="currentColor"
          stroke-width="1"></path
        ></svg
      >
      <span class="relative z-10"><slot /></span>
    </button>
  )
}

<style>
  .tara-framed-btn :global(.tara-flourish) {
    position: absolute;
    width: 0.7rem;
    height: 0.7rem;
    pointer-events: none;
    opacity: 0.85;
  }
  .tara-framed-btn :global(.tf-tl) {
    top: 0.2rem;
    left: 0.2rem;
  }
  .tara-framed-btn :global(.tf-tr) {
    top: 0.2rem;
    right: 0.2rem;
    transform: rotate(90deg);
  }
  .tara-framed-btn :global(.tf-br) {
    bottom: 0.2rem;
    right: 0.2rem;
    transform: rotate(180deg);
  }
  .tara-framed-btn :global(.tf-bl) {
    bottom: 0.2rem;
    left: 0.2rem;
    transform: rotate(270deg);
  }
</style>
