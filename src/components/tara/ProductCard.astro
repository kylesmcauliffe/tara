---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { formatPrice } from "@/data/tara";

interface Props {
  name: string;
  subtitle?: string;
  price: number;
  href: string;
  image: ImageMetadata;
  class?: string;
}

const {
  name,
  subtitle,
  price,
  href,
  image,
  class: className = "",
} = Astro.props;
---

<a href={href} class={`group block tara-hover-fade ${className}`.trim()}>
  <div class="tara-frame-thin overflow-hidden bg-taupe/40 aspect-[3/4]">
    <Image
      src={image}
      alt={name}
      class="size-full object-cover tara-img-zoom"
      widths={[400, 640, 800]}
      sizes="(max-width: 768px) 50vw, 33vw"
      loading="lazy"
    />
  </div>
  <div class="mt-4 text-center px-2">
    <p class="text-[11px] tracking-[0.18em] uppercase text-charcoal/70">
      {subtitle ?? name}
    </p>
    <h3 class="mt-1 font-serif text-lg md:text-xl tracking-wide text-charcoal">
      {name}
    </h3>
    <p class="mt-1 text-sm tracking-wide text-charcoal/80">{formatPrice(price)}</p>
  </div>
</a>
