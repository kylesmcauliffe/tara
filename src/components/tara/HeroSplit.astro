---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Panel {
  title: string;
  href: string;
  image: ImageMetadata;
  cta?: string;
}

interface Props {
  left: Panel;
  right: Panel;
  class?: string;
}

const { left, right, class: className = "" } = Astro.props;
const panels = [left, right];
---

<section class={`relative w-full ${className}`.trim()}>
  <div class="grid grid-cols-1 md:grid-cols-2 min-h-[calc(100svh-5.5rem)]">
    {
      panels.map((panel, i) => (
        <a
          href={panel.href}
          class:list={[
            "group relative block overflow-hidden min-h-[55svh] md:min-h-0",
            i === 0 ? "tara-fade-in" : "tara-fade-in-delay",
          ]}
        >
          <Image
            src={panel.image}
            alt={panel.title}
            class="absolute inset-0 size-full object-cover tara-img-zoom"
            widths={[640, 960, 1280]}
            sizes="(max-width: 768px) 100vw, 50vw"
            loading={i === 0 ? "eager" : "lazy"}
          />
          <div class="absolute inset-0 bg-black/15 group-hover:bg-black/25 transition-colors duration-500" />
          <div class="absolute inset-0 flex flex-col items-center justify-center gap-5 text-center px-6">
            <h2 class="font-script text-white text-4xl md:text-5xl lg:text-6xl tracking-wide drop-shadow-sm">
              {panel.title}
            </h2>
            <span class="inline-flex items-center justify-center px-8 py-3 text-[11px] tracking-[0.22em] uppercase font-serif text-white border border-white/90 bg-white/10 backdrop-blur-[1px] group-hover:bg-white group-hover:text-charcoal transition-colors duration-300">
              {panel.cta ?? "Shop Now"}
            </span>
          </div>
        </a>
      ))
    }
  </div>
</section>
