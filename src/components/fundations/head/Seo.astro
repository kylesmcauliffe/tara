---
import { AstroSeo } from "@astrolib/seo";

const {
  title = "TARA | Official Site",
  description = "Tara — refined clothing for everyday elegance. Dresses, knitwear, and finishing touches.",
  canonical = "https://yourwebsite.com",
} = Astro.props;
---

<AstroSeo
  title={title}
  description={description}
  canonical={canonical}
  openGraph={{
    url: canonical,
    title,
    description,
    images: [
      {
        url: "https://yourwebsite.com/og-image.jpg",
        width: 1200,
        height: 630,
        alt: "TARA",
        type: "image/jpeg",
      },
    ],
    site_name: "TARA",
    type: "website",
    locale: "en_US",
  }}
  twitter={{
    handle: "@tara",
    site: "@tara",
    cardType: "summary_large_image",
  }}
/>
