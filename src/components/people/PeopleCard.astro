---
// Assets
import { Image } from "astro:assets";
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
// Content
const { name, role, url, image } = {
  url: "/people/" + Astro.props.person.slug,
  name: Astro.props.person.data.name,
  role: Astro.props.person.data.role,
  image: Astro.props.person.data.image?.url,
};
---
<article class="relative flex flex-col">
  <a
    href={url}
    title={`View person: ${name}`}
    aria-label={`View person: ${name}`}
    class="absolute inset-0 z-10"></a>
  <Image
    src={image}
    alt={name}
    width={800}
    height={800}
    loading="eager"
    decoding="async"
    class="aspect-square lg:aspect-9/12 object-cover object-top saturate-50"
  />
  <div class="mt-4">
    <Text
      tag="h3"
      variant="textXL"
      class="font-medium text-base-900 font-serif"
    >
      {name}
    </Text>
    <Text tag="p" variant="textBase" class="text-base-600 mt-2">
      {role}
    </Text>
  </div>
</article>
