---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Components
import GalleryCard from "@/components/gallery/GalleryCard.astro";
// Content
import { getCollection } from "astro:content";

const allGalleries = await getCollection("gallery");
const galleries = allGalleries.sort(
  (a, b) => (a.data.order || 0) - (b.data.order || 0)
);
---

<section>
  <Wrapper variant="standard" class="py-12 lg:py-24">
    <Text
      tag="h2"
      variant="displayLG"
      class="text-base-900 font-serif font-light leading-snug tracking-tight"
    >
      Little moments we can’t wait to share.
    </Text>

    <div
      class="mt-12  grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3"
    >
      {galleries.slice(0, 3).map((album) => <GalleryCard album={album} />)}
    </div>
  </Wrapper>
</section>
