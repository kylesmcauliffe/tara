---
// Assets
import { Image } from "astro:assets";
import info from "@/images/assets/info.png";
import rsvp from "@/images/assets/rsvp.png";
import wishlist from "@/images/assets/wishlist.png";
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
const actions = [
  {
    title: "RSVP",
    description:
      "Let us know if you’ll be joining us for the ceremony, reception, or the brunch so we can save you a seat, a glass, and a slice of cake.",
    url: "/rsvp",
    cta: "Respond",
    image: rsvp,
    alt: "RSVP card with RSVP typography",
  },
  {
    title: "Info",
    description:
      "Directions, hotels, parking, dress code, and every practical detail in one place so you can focus on celebrating, not logistics.",
    url: "/info",
    cta: "Read Info",
    image: info,
    alt: "Map with wedding info marker",
  },
  {
    title: "Wishlist",
    description:
      "A few things we’d love as we start this next chapter—only if you’d like to gift, no pressure and zero wrapping stress.",
    url: "/wishlist",
    cta: "View Wishlist",
    image: wishlist,
    alt: "Gift boxes illustration",
  },
];
---

<section>
  <Wrapper variant="standard" class="py-12 lg:py-24">
    <div class="flex flex-col gap-8">
      {
        actions.map((action) => (
          <article class="relative grid gird-cols-1 lg:grid-cols-2 ">
            <Image
              src={action.image}
              alt={action.alt}
              width="1290"
              height="1290"
              loading="eager"
              decoding="async"
              class="aspect-square  object-cover object-top saturate-50"
            />
            <div class="p-8 bg-accent-950 flex flex-col h-full justify-between gap-4">
              <div>
                <Text
                  tag="h3"
                  variant="displayLG"
                  class="font-serif text-base-50 mt-4"
                >
                  {action.title}
                </Text>
                <Text tag="p" variant="textLG" class="text-base-200 mt-4">
                  {action.description}
                </Text>
              </div>
              <a
                href={action.url}
                class="inline-block text-base-50 text-2xl hover:text-base-600 duration-600"
              >
                {action.cta}
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </Wrapper>
</section>
