---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Content
import { getCollection } from "astro:content";

const [events, locations] = await Promise.all([
  getCollection("events"),
  getCollection("locations"),
]);

const locationLookup = new Map(
  locations.map((location) => [location.slug, location.data])
);

const prioritizedSlugs = [
  "ceremony",
  "cocktail-hour",
  "dinner",
  "party",
  "next-day-brunch",
];

const timeline = prioritizedSlugs
  .map((slug) => {
    const event = events.find((entry) => entry.slug === slug);
    if (!event) return null;
    const location =
      (event.data.locationSlug &&
        locationLookup.get(event.data.locationSlug)) ||
      null;
    return {
      slug,
      title: event.data.title,
      description: event.data.description,
      startTime: event.data.startTime,
      endTime: event.data.endTime,
      locationName: location?.name,
      locationCity: location?.city,
    };
  })
  .filter((entry): entry is NonNullable<typeof entry> => Boolean(entry));
---

<section>
  <Wrapper variant="standard" class="py-12 lg:py-32">
    <Text
      tag="h2"
      variant="displayLG"
      class="text-base-900 font-serif font-light leading-snug tracking-tight"
    >
      Know where to be and when the party starts <br> — a short schedule for the day.
    </Text>

    <ol class="relative space-y-12 lg:col-span-2 mt-12">
      {
        timeline.map((item, index) => (
          <li
            class="relative flex flex-col gap-4 lg:flex-row lg:items-center lg:gap-12"
            aria-label={item.title}
          >
            <Text
              tag="p"
              variant="display6XL"
              class="font-display text-base-900 italic font-light"
            >
              {String(index + 1).padStart(2, "0")}.—
            </Text>
            <div class="flex flex-col h-full justify-between gap-8 text-balance max-w-md">
              <div>
                <Text
                  tag="h3"
                  variant="displayMD"
                  class="font-serif text-base-900"
                >
                  {item.title}
                </Text>
                <Text tag="p" variant="textBase" class="text-base-600 mt-4">
                  {item.description}
                </Text>
              </div>
              <Text
                tag="p"
                variant="textSM"
                class="text-base-600 flex items-center gap-2"
              >
                {item.startTime}
                {item.endTime && ` – ${item.endTime}`}
                <span aria-hidden="true">·</span>
                {item.locationName}
                {item.locationCity && ` · ${item.locationCity}`}
              </Text>
            </div>
          </li>
        ))
      }
    </ol>
  </Wrapper>
</section>
