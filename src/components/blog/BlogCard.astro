---
// Assets
import { Image } from "astro:assets";
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
// Content
const { title, description, url, image } = {
  url: "/blog/posts/" + Astro.props.post.slug,
  title: Astro.props.post.data.title,
  description: Astro.props.post.data.description,
  image: Astro.props.post.data.image.url,
};
---

<article class="relative flex flex-col">
  <a
    href={url}
    title={`Read more: ${title}`}
    aria-label={`Read blog post: ${title}`}
    class="absolute inset-0 z-10"></a>
  <Image
    src={image}
    alt={title}
    width={800}
    height={800}
    loading="eager"
    decoding="async"
    class="aspect-square lg:aspect-9/12 object-cover object-top saturate-50"
  />
  <div class="mt-4">
    <Text tag="h3" variant="textLG" class="font-medium text-base-900 font-serif mt-4"
      >{title}</Text
    >
    
  </div>
</article>
