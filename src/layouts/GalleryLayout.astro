---
// Assets
import { Image } from "astro:assets";
import Symbol from "@/components/assets/Symbol.astro";
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Components
import GalleryCard from "@/components/gallery/GalleryCard.astro";
const { frontmatter, item } = Astro.props;
// Get related gallery albums
import { getCollection } from "astro:content";
const allGalleries = await getCollection("gallery");
const relatedGalleries = allGalleries
  .filter((g) => g.slug !== item.slug)
  .sort((a, b) => (a.data.order || 0) - (b.data.order || 0))
  .slice(0, 3);
// Sort images by order
const sortedImages =
  frontmatter.images?.sort((a, b) => (a.order || 0) - (b.order || 0)) || [];
---

<BaseLayout>
  <section>
    <Wrapper variant="wide" class="py-24 lg:py-32">
      <div class="relative overflow-hidden h-[calc(100dvh-10rem)]">
        <Image
          src={frontmatter.coverImage.url}
          alt={frontmatter.coverImage.alt}
          width="1440"
          height="1193"
          loading="eager"
          decoding="async"
          class="size-full object-cover object-top saturate-50"
        />
        <div
          class="absolute inset-0 flex flex-col items-center text-center justify-center bg-black/30"
        >
          <Text
            tag="h1"
            variant="displayXL"
            class="font-display text-white uppercase"
          >
            {frontmatter.title}
          </Text>
        </div>
      </div>
    </Wrapper>
    <Wrapper variant="standard" class="pb-24">
      <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
        <div>
          <div class="lg:sticky lg:top-32">
            <Text
              tag="h3"
              variant="textXL"
              class="text-base-900 font-serif mb-4"
            >
              Gallery Info
            </Text>
            <div class="space-y-4 mt-8 pt-8 border-t border-base-200">
              <div>
                <Text
                  tag="p"
                  variant="textSM"
                  class="text-base-500 font-medium"
                >
                  Album
                </Text>
                <Text tag="p" variant="textBase" class="text-base-900">
                  {frontmatter.title}
                </Text>
              </div>
              <div>
                <Text
                  tag="p"
                  variant="textSM"
                  class="text-base-500 font-medium"
                >
                  Photos
                </Text>
                <Text tag="p" variant="textBase" class="text-base-900">
                  {sortedImages.length}
                  {sortedImages.length === 1 ? "photo" : "photos"}
                </Text>
              </div>
              <div>
                <Text
                  tag="p"
                  variant="textSM"
                  class="text-base-500 font-medium"
                >
                  Description
                </Text>
                <Text tag="p" variant="textSM" class="text-base-700">
                  {frontmatter.description}
                </Text>
              </div>
            </div>
            <div class="mt-8">
              <Text
                tag="h4"
                variant="textLG"
                class="text-base-900 font-serif mb-4"
              >
                Other Albums
              </Text>
              <div class="space-y-3">
                {
                  relatedGalleries.map((gallery) => (
                    <div>
                      <Text tag="p" variant="textSM" class="text-base-600">
                        <a
                          href={`/gallery/album/${gallery.slug}`}
                          class="text-base-900 hover:text-accent-600 underline font-medium"
                        >
                          {gallery.data.title}
                        </a>
                      </Text>
                    </div>
                  ))
                }
              </div>
            </div>
          </div>
        </div>
        <div class="lg:col-span-3">
          <Text
            tag="h1"
            variant="displayXL"
            class="text-base-900 font-display italic font-light leading-tight"
          >
            {frontmatter.title}
          </Text>
          <Text
            tag="p"
            variant="textLG"
            class="text-base-600 mt-4 text-balance"
          >
            {frontmatter.description}
          </Text>

          <div class="flex flex-col gap-12 mt-12 ">
            {
              sortedImages.map((image, index) => (
                <div class="group">
                  <Image
                    src={image.url}
                    alt={image.alt}
                    width={1200}
                    height={800}
                    loading="eager"
                    decoding="async"
                    class="aspect-square lg:aspect-12/7 object-cover object-center saturate-50 group-hover:saturate-100 transition-all duration-300 w-full"
                  />
                  {image.caption && image.caption !== "#_" && (
                    <Text
                      tag="p"
                      variant="textSM"
                      class="text-base-500 mt-2 italic"
                    >
                      {image.caption}
                    </Text>
                  )}
                </div>
              ))
            }
          </div>
        </div>
      </div>
      <div class="mt-24 lg:mt-32 text-center">
        <Symbol class="h-24 mx-auto" />
        <Text
          tag="h2"
          variant="display2XL"
          class="text-base-900 font-serif font-light leading-snug tracking-tight"
        >
          Captured moments from our special celebration
        </Text>
      </div>
    </Wrapper>
  </section>
</BaseLayout>
