---
// Assets
import { Image } from "astro:assets";
import Symbol from "@/components/assets/Symbol.astro";
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Components
import WishlistCard from "@/components/wishlist/WishlistCard.astro";
const { frontmatter, item } = Astro.props;
// Get related items by category
import { getCollection } from "astro:content";
const allWishlist = await getCollection("wishlist");
const relatedItems = allWishlist.filter(
  (w) => w.data.category === frontmatter.category && w.slug !== item.slug
);
---

<BaseLayout>
  <section>
    <Wrapper variant="wide" class="py-24 lg:py-32">
      <div class="grid grid-cols-1 lg:grid-cols-3">
        <div
          class="p-8 bg-accent-950 lg:p-12 flex flex-col h-full justify-between gap-12 lg:col-span-2"
        >
          <div>
            <Text
              tag="h1"
              variant="displayLG"
              class="text-base-50 font-serif font-light leading-snug tracking-tight"
            >
              {frontmatter.title}
            </Text>
            <Text
              tag="p"
              variant="textLG"
              class="text-base-200 mt-1 text-balance"
            >
              {frontmatter.description}
            </Text>
            <div
              class="text-base-200 mt-12 text-base text-pretty lg:text-lg leading-snug"
            >
              <slot />
            </div>

            <div
              class="flex flex-col gap-1 mt-12 pt-12 border-t border-accent-800"
            >
              <div class="flex items-baseline lg:justify-between w-full">
                <Text tag="h3" variant="textSM" class="text-base-50"
                  >Price:</Text
                >
                <span class="flex-1 mx-2 border-b border-accent-800"
                ></span><Text tag="p" variant="textSM" class="text-base-200"
                  >{frontmatter.price}</Text
                >
              </div>

              <div class="flex items-baseline lg:justify-between w-full">
                <Text tag="h3" variant="textSM" class="text-base-50"
                  >Store:</Text
                >
                <span class="flex-1 mx-2 border-b border-accent-800"
                ></span><Text tag="p" variant="textSM" class="text-base-200"
                  >{frontmatter.store}</Text
                >
              </div>
              <div class="flex items-baseline lg:justify-between w-full">
                <Text tag="h3" variant="textSM" class="text-base-50"
                  >Status:</Text
                >
                <span class="flex-1 mx-2 border-b border-accent-800"
                ></span><Text tag="p" variant="textSM" class="text-base-200">
                  {frontmatter.status}
                </Text>
              </div>
            </div>
          </div>
          <Button
            isLink
            variant="muted"
            size="xl"
            href={frontmatter.link}
            class="w-fit"
          >
            View in store
          </Button>
        </div>
        <Image
          src={frontmatter.image.url}
          alt={frontmatter.image.alt}
          width="1440"
          height="1193"
          loading="eager"
          decoding="async"
          class="aspect-square lg:aspect-9/12 lg:h-full object-cover object-top saturate-50 order-first lg:order-none"
        />
      </div>
      <div class="mt-12 lg:mt-32 text-center">
        <Symbol class="h-24 mx-auto" />
        <Text
          tag="h2"
          variant="display2XL"
          class="text-base-900 font-serif font-light leading-snug tracking-tight mt-24 text-balance"
        >
          Thank you for helping us make these next chapters a little sweeter.
        </Text>
        <div
          aria-hidden="true"
          class="h-1 bg-base-900 max-w-24 mx-auto mt-24 rounded-full pointer-events-none"
        >
        </div>
      </div>
    </Wrapper>
  </section>
  {
    relatedItems.length > 0 && (
      <section>
        <Wrapper variant="standard" class="py-12 lg:py-24">
          <Text
            tag="h2"
            variant="displayLG"
            class="text-base-900 font-serif font-light leading-snug tracking-tight"
          >
            Related Items
          </Text>
          <div class="mt-12  grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
            {relatedItems.slice(0, 3).map((relatedItem) => (
              <WishlistCard wishlist={relatedItem} />
            ))}
          </div>
        </Wrapper>
      </section>
    )
  }
</BaseLayout>
