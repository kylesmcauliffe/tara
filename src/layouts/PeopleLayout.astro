---
// Assets
import { Image } from "astro:assets";
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
const { frontmatter, item } = Astro.props;
---
<BaseLayout>
  <section>
    <Wrapper variant="wide" class="py-24 lg:py-32">
      <div class="mt-12 lg:mt-24 grid gap-12 lg:grid-cols-3">
        <div>
          <Image
            src={frontmatter.image.url}
            alt={frontmatter.image.alt}
            width="1440"
            height="1193"
            loading="eager"
            decoding="async"
            class="size-full object-cover object-top saturate-50"
          />
        </div>
        <div class="lg:col-span-2">
            <Text
              tag="p"
              variant="display2XL"
              class="text-base-900 text-balance font-display italic"
            >
              {frontmatter.role}
            </Text>
          <Text
            tag="h1"
            variant="displayLG"
            class="text-base-900 font-serif font-light leading-snug tracking-tight mt-12"
          >
            {frontmatter.name}
          </Text>
          <Text tag="p" variant="textSM" class="text-base-600">
            {frontmatter.bio}
          </Text>
          <Wrapper variant="prose" class="lg:columns-2 mt-12">
            <slot />
          </Wrapper>
        </div>
      </div>
    </Wrapper>
  </section>
</BaseLayout>
