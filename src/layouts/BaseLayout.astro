---
import "@/styles/global.css";
import BaseHead from "@/components/fundations/head/BaseHead.astro";
import Footer from "@/components/global/Footer.astro";
import Navigation from "@/components/global/Navigation.astro";
import CartDrawer from "@/components/tara/CartDrawer.astro";
import { getImage } from "astro:assets";
import { taraImages } from "@/data/images";

const { hideNavigation = false, hideFooter = false } = Astro.props;

const imageMapEntries = await Promise.all(
  Object.entries(taraImages).map(async ([key, img]) => {
    const optimized = await getImage({ src: img, width: 160 });
    return [key, optimized.src] as const;
  }),
);
const cartImageMap = Object.fromEntries(imageMapEntries);
---

<html lang="en" class="scroll-smooth">
  <head>
    <BaseHead />
  </head>
  <body class="flex flex-col min-h-svh text-charcoal bg-cream font-serif">
    {!hideNavigation && <Navigation />}
    <main class="grow"><slot /></main>
    {!hideFooter && <Footer />}
    <CartDrawer />
    <script
      type="application/json"
      id="cart-image-map"
      set:html={JSON.stringify(cartImageMap)}
    />
  </body>
</html>
