---
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import { getTaraImage } from "@/data/images";
---

<BaseLayout hideNavigation={true} hideFooter={true}>
  <section>
    <Wrapper variant="wide" class="py-8">
      <div class="relative overflow-hidden h-[calc(100dvh-4rem)]">
        <Image
          src={getTaraImage("collection-strip")}
          alt="Tara"
          widths={[800, 1280, 1920]}
          sizes="100vw"
          loading="eager"
          decoding="async"
          class="size-full object-cover object-center saturate-50"
        />
        <div
          class="absolute inset-0 flex flex-col items-center text-center justify-center bg-black/30"
        >
          <Text
            tag="h1"
            variant="display4XL"
            class="font-display text-white uppercase"
          >
            404
          </Text>
          <div class="mt-10 flex flex-col sm:flex-row gap-8 lg:gap-12">
            <a
              href="/"
              class="text-4xl font-medium tracking-tight font-display uppercase focus:outline-none text-white"
              >Home</a
            >
            <a
              href="/shop"
              class="text-4xl font-medium tracking-tight font-display uppercase focus:outline-none text-white"
              >Shop</a
            >
            <a
              href="/collections"
              class="text-4xl font-medium tracking-tight font-display uppercase focus:outline-none text-white"
              >Collections</a
            >
          </div>
        </div>
      </div>
    </Wrapper>
  </section>
</BaseLayout>
