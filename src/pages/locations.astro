---
// Assets
import { Image } from "astro:assets";
import info from "@/images/assets/info.png";
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Components
import LocationCard from "@/components/locations/LocationCard.astro";
// Content
import { getCollection } from "astro:content";

const allLocations = (await getCollection("locations")).sort(
  (a, b) => (a.data.order || 0) - (b.data.order || 0)
);
---

<BaseLayout>
  <section>
    <Wrapper variant="wide" class="pt-24 lg:pt-32">
      <Image
        src={info}
        alt="info"
        width="1440"
        height="1193"
        loading="eager"
        decoding="async"
        class="w-full max-h-100 object-cover object-center saturate-50"
      />
    </Wrapper>
    <Wrapper variant="standard" class="py-24">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        <div>
          <div class="lg:sticky lg:top-32">
            <Text
              tag="h2"
              variant="displayLG"
              class="text-base-900 font-serif font-light leading-snug tracking-tight"
            >
            Venues
            </Text>
            <Text tag="p" variant="textBase" class="text-base-600 mt-4">
              All the beautiful locations where our wedding celebration will
              take place throughout the weekend.
            </Text>
          </div>
        </div>

        <div class="space-y-8 lg:col-span-2">
          {allLocations.map((location) => <LocationCard location={location} />)}
        </div>
      </div>
    </Wrapper>
  </section>
</BaseLayout>
