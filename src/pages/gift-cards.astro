---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import FramedButton from "@/components/tara/FramedButton.astro";
import { giftCards, formatPrice } from "@/data/tara";
---

<BaseLayout>
  <section class="pt-14 pb-10 lg:pt-20 lg:pb-14">
    <Wrapper variant="wide" class="text-center max-w-2xl mx-auto">
      <p class="text-[11px] tracking-[0.28em] uppercase text-charcoal/50">
        Discover
      </p>
      <h1
        class="mt-3 font-script text-4xl md:text-5xl lg:text-6xl text-charcoal tara-fade-in"
      >
        Gift Cards
      </h1>
      <p class="mt-4 text-base md:text-lg text-charcoal/70 leading-relaxed font-serif">
        A thoughtful note for someone else—or for yourself. Redeemable online and
        in our shops.
      </p>
    </Wrapper>
  </section>

  <section class="pb-20 lg:pb-28">
    <Wrapper variant="wide">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-10 max-w-5xl mx-auto">
        {
          giftCards.map((card) => (
            <article class="text-center border border-taupe p-8 lg:p-10 tara-frame-thin bg-cream">
              <p class="text-[10px] tracking-[0.22em] uppercase text-charcoal/50">
                {card.type === "digital" ? "Digital" : "Physical"}
              </p>
              <h2 class="mt-3 font-script text-3xl text-charcoal">{card.name}</h2>
              <p class="mt-2 text-xl text-charcoal/80">{formatPrice(card.amount)}</p>
              <p class="mt-4 text-sm text-charcoal/65 leading-relaxed font-serif">
                {card.description}
              </p>
              <div class="mt-8">
                <FramedButton href="/contact">Inquire</FramedButton>
              </div>
            </article>
          ))
        }
      </div>

      <div class="mt-16 text-center max-w-md mx-auto">
        <p class="text-[11px] tracking-[0.2em] uppercase text-charcoal/50 mb-3">
          Check Balance
        </p>
        <p class="text-sm text-charcoal/65 font-serif mb-6">
          Have a gift card? Contact us with your card number and we’ll confirm
          the remaining balance.
        </p>
        <FramedButton href="/contact">Gift Card Balance</FramedButton>
      </div>
    </Wrapper>
  </section>
</BaseLayout>
