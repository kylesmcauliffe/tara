---
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import FramedButton from "@/components/tara/FramedButton.astro";
import { shops, getShop } from "@/data/tara";
import { getTaraImage } from "@/data/images";

export function getStaticPaths() {
  return shops.map((s) => ({ params: { slug: s.slug } }));
}

const { slug } = Astro.params;
const shop = getShop(slug!);
if (!shop) {
  return Astro.redirect("/shops");
}
---

<BaseLayout>
  <section class="py-10 lg:py-0">
    <div class="grid grid-cols-1 lg:grid-cols-2 min-h-[calc(100svh-5.5rem)]">
      <div class="relative min-h-[50svh] lg:min-h-0 overflow-hidden">
        <Image
          src={getTaraImage(shop.imageKey)}
          alt={`${shop.name} — ${shop.city}`}
          class="absolute inset-0 size-full object-cover"
          widths={[640, 960, 1280]}
          sizes="(max-width: 1024px) 100vw, 50vw"
          loading="eager"
        />
      </div>

      <div class="flex items-center bg-cream">
        <Wrapper variant="wide" class="py-14 lg:py-20 lg:px-16">
          <p class="text-[11px] tracking-[0.28em] uppercase text-charcoal/50">
            <a href="/shops" class="hover:opacity-60 transition-opacity"
              >Our Shops</a
            >
          </p>
          <h1 class="mt-3 font-script text-4xl md:text-5xl text-charcoal tara-fade-in">
            {shop.city}
          </h1>
          <p class="mt-2 text-[12px] tracking-[0.18em] uppercase text-charcoal/70">
            {shop.name}
          </p>

          <div class="mt-10 space-y-2 text-[12px] tracking-[0.16em] uppercase text-charcoal">
            <p>{shop.address}</p>
            <p>{shop.cityLine}</p>
          </div>

          <div class="mt-8 space-y-3 text-sm text-charcoal/75 font-serif">
            <p>
              <span class="text-[11px] tracking-[0.18em] uppercase text-charcoal/50 block mb-1"
                >Hours</span
              >
              {shop.hours}
            </p>
            <p>
              <span class="text-[11px] tracking-[0.18em] uppercase text-charcoal/50 block mb-1"
                >Phone</span
              >
              <a href={`tel:${shop.phone.replace(/\D/g, "")}`} class="hover:opacity-60"
                >{shop.phone}</a
              >
            </p>
            <p>
              <span class="text-[11px] tracking-[0.18em] uppercase text-charcoal/50 block mb-1"
                >Email</span
              >
              <a href={`mailto:${shop.email}`} class="hover:opacity-60"
                >{shop.email}</a
              >
            </p>
          </div>

          <div class="mt-10">
            <FramedButton href={shop.mapsUrl}>Get Directions</FramedButton>
          </div>
        </Wrapper>
      </div>
    </div>
  </section>
</BaseLayout>
