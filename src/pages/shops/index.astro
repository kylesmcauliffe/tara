---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import ShopCard from "@/components/tara/ShopCard.astro";
import { shops } from "@/data/tara";
import { getTaraImage } from "@/data/images";
---

<BaseLayout>
  <section class="pt-14 pb-10 lg:pt-20 lg:pb-14">
    <Wrapper variant="wide" class="text-center max-w-2xl mx-auto">
      <p class="text-[11px] tracking-[0.28em] uppercase text-charcoal/50">
        Visit
      </p>
      <h1
        class="mt-3 font-script text-4xl md:text-5xl lg:text-6xl text-charcoal tara-fade-in"
      >
        Our Shops
      </h1>
      <p class="mt-4 text-base md:text-lg text-charcoal/70 leading-relaxed font-serif">
        Three California shops—quiet floors, good light, and pieces you can try
        on in person.
      </p>
    </Wrapper>
  </section>

  <section class="pb-20 lg:pb-28">
    <Wrapper variant="wide">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-12 lg:gap-10">
        {
          shops.map((shop) => (
            <ShopCard
              city={shop.city}
              name={shop.name}
              address={shop.address}
              cityLine={shop.cityLine}
              href={`/shops/${shop.slug}`}
              image={getTaraImage(shop.imageKey)}
            />
          ))
        }
      </div>
    </Wrapper>
  </section>
</BaseLayout>
