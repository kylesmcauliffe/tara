---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import FramedButton from "@/components/tara/FramedButton.astro";
---

<BaseLayout>
  <section class="pt-14 pb-20 lg:pt-20 lg:pb-28">
    <Wrapper variant="wide" class="max-w-2xl mx-auto">
      <div class="text-center mb-12">
        <p class="text-[11px] tracking-[0.28em] uppercase text-charcoal/50">
          Assistance
        </p>
        <h1 class="mt-3 font-script text-4xl md:text-5xl text-charcoal tara-fade-in">
          Returns
        </h1>
      </div>

      <div class="space-y-8 text-base text-charcoal/75 leading-relaxed font-serif">
        <div>
          <h2 class="text-[12px] tracking-[0.16em] uppercase text-charcoal mb-3">
            Window
          </h2>
          <p>
            Unworn pieces with original tags may be returned within 14 days of
            delivery for a refund to the original payment method.
          </p>
        </div>
        <div>
          <h2 class="text-[12px] tracking-[0.16em] uppercase text-charcoal mb-3">
            Condition
          </h2>
          <p>
            Items should be free of wear, fragrance, and alterations. Final sale
            and gift cards are not eligible for return.
          </p>
        </div>
        <div>
          <h2 class="text-[12px] tracking-[0.16em] uppercase text-charcoal mb-3">
            How to start
          </h2>
          <p>
            Email us with your order number and the pieces you’d like to return.
            We’ll send a prepaid label for US orders when available.
          </p>
        </div>
      </div>

      <div class="mt-12 text-center">
        <FramedButton href="/contact">Start a Return</FramedButton>
      </div>
    </Wrapper>
  </section>
</BaseLayout>
