---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

const links = [
  { label: "Track Order", href: "/track-order", note: "Look up a recent order" },
  { label: "Returns", href: "/returns", note: "Shipping & return guidelines" },
  { label: "FAQ", href: "/faq", note: "Sizing, care, and orders" },
  { label: "Contact", href: "/contact", note: "Email or write to us" },
  {
    label: "Gift Card Balance",
    href: "/gift-cards",
    note: "Check or purchase a gift card",
  },
];
---

<BaseLayout>
  <section class="pt-14 pb-20 lg:pt-20 lg:pb-28">
    <Wrapper variant="wide" class="max-w-xl mx-auto">
      <div class="text-center mb-12">
        <p class="text-[11px] tracking-[0.28em] uppercase text-charcoal/50">
          Help
        </p>
        <h1 class="mt-3 font-script text-4xl md:text-5xl text-charcoal tara-fade-in">
          Assistance
        </h1>
      </div>
      <ul class="divide-y divide-taupe border-y border-taupe">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 py-5 hover:opacity-60 transition-opacity"
              >
                <span class="text-[12px] tracking-[0.18em] uppercase text-charcoal">
                  {link.label}
                </span>
                <span class="text-sm text-charcoal/55 font-serif">{link.note}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </Wrapper>
  </section>
</BaseLayout>
