---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

const pageSections = [
  {
    title: "Main Pages",
    columns: [
      {
        category: "Storefront",
        links: [
          { text: "Home", href: "/" },
          { text: "Shop", href: "/shop" },
          { text: "Collections", href: "/collections" },
          { text: "404", href: "/404" },
        ],
      },
      {
        category: "System",
        links: [
          { text: "Colors", href: "/system/colors" },
          { text: "Links", href: "/system/link" },
          { text: "Buttons", href: "/system/buttons" },
          { text: "Typography", href: "/system/typography" },
        ],
      },
    ],
  },
];
---

<BaseLayout>
  <section>
    <Wrapper variant="standard" class="py-24 lg:py-32">
      <Text
        tag="h1"
        variant="displayLG"
        class="text-base-900 font-serif font-light leading-snug tracking-tight"
      >
        Overview
      </Text>
      <div class="flex flex-col mt-12 gap-24">
        {
          pageSections.map((section) => (
            <div>
              <Text
                tag="h3"
                variant="textXL"
                class="font-medium font-serif font-light text-base-900"
              >
                {section.title}
              </Text>
              <div class="mt-8 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-12 xl:grid-cols-5">
                {section.columns.map((column) => (
                  <div>
                    <Text
                      tag="p"
                      variant="textBase"
                      class="font-medium text-base-900"
                    >
                      {column.category}
                    </Text>
                    <ul role="list" class="mt-2 ">
                      {column.links.map((link) => (
                        <li>
                          <Text
                            tag="a"
                            variant="textSM"
                            href={link.href}
                            class="text-base-500 hover:text-base-900 duration-300"
                          >
                            {link.text}
                          </Text>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </Wrapper>
  </section>
</BaseLayout>
