---
// Assets
import { Image } from "astro:assets";
import events from "@/images/assets/events.png";
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Components
import EventCard from "@/components/events/EventCard.astro";
// Content
import { getCollection } from "astro:content";

const allEvents = (await getCollection("events")).sort(
  (a, b) => (a.data.order || 0) - (b.data.order || 0)
);
---

<BaseLayout>
  <section>
    <Wrapper variant="wide" class="pt-24 lg:pt-32">
      <Image
        src={events}
        alt="events"
        width="1440"
        height="1193"
        loading="eager"
        decoding="async"
        class="w-full max-h-100 object-cover object-center saturate-50"
      />
    </Wrapper>
  </section>

  <section>
    <Wrapper variant="standard" class="py-12 lg:py-24">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        <div>
          <div class="lg:sticky lg:top-32">
            <Text
              tag="h2"
              variant="displayLG"
              class="text-base-900 font-serif font-light leading-snug tracking-tight"
            >
              Happenings
            </Text>
            <Text tag="p" variant="textBase" class="text-base-600 mt-4">
              Join us for a weekend of celebration with multiple events planned
              to make our wedding unforgettable.
            </Text>
          </div>
        </div>

        <div class="flex flex-col lg:col-span-2 gap-8">
          {allEvents.map((event) => <EventCard event={event} />)}
        </div>
      </div>
    </Wrapper>
  </section>
</BaseLayout>
