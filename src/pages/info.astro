---
// Assets
import { Image } from "astro:assets";
import info from "@/images/assets/info.png";
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Content
import { getCollection } from "astro:content";
const allLocations = await getCollection("locations");
const ceremonyVenue = allLocations.find((loc) => loc.data.type === "ceremony");
const receptionVenue = allLocations.find(
  (loc) => loc.data.type === "reception"
);
const hotelVenue = allLocations.find((loc) => loc.slug === "hotel-restaurant");

// The info SECTIONS — clean and structured
const infoSections = [
  {
    title: "Venue Addresses",
    items: [
      `Ceremony — ${ceremonyVenue?.data.name}: ${ceremonyVenue?.data.address}`,
      `Reception — ${receptionVenue?.data.name}: ${receptionVenue?.data.address}`,
      `Next-Day Brunch — ${hotelVenue?.data.name}: ${hotelVenue?.data.address}`,
    ],
  },
  {
    title: "Maps & Directions",
    items: ["Click on the maps below to open in Google Maps for directions."],
    maps: [
      {
        title: ceremonyVenue?.data.name || "Ceremony Location",
        address: ceremonyVenue?.data
          ? `${ceremonyVenue.data.address}, ${ceremonyVenue.data.city}, ${ceremonyVenue.data.country}`
          : "Address not available",
        embedUrl: ceremonyVenue?.data
          ? `https://maps.google.com/maps?q=${encodeURIComponent(ceremonyVenue.data.address + ", " + ceremonyVenue.data.city + ", " + ceremonyVenue.data.country)}&output=embed`
          : "",
      },
      {
        title: receptionVenue?.data.name || "Reception Location",
        address: receptionVenue?.data
          ? `${receptionVenue.data.address}, ${receptionVenue.data.city}, ${receptionVenue.data.country}`
          : "Address not available",
        embedUrl: receptionVenue?.data
          ? `https://maps.google.com/maps?q=${encodeURIComponent(receptionVenue.data.address + ", " + receptionVenue.data.city + ", " + receptionVenue.data.country)}&output=embed`
          : "",
      },
    ],
  },
  {
    title: "Parking",
    items: [
      "Free parking available at both venues.",
      "Please arrive early to secure a spot for the ceremony.",
    ],
  },
  {
    title: "Shuttle & Transport",
    items: [
      "A shuttle runs every 20 minutes from Hillside Hotel to the ceremony.",
      "Taxis and rideshare options are available all day.",
    ],
  },
  {
    title: "Hotel Recommendations",
    items: [
      "Hillside Hotel — closest to the venue.",
      "Lakeview Inn — a 10-minute drive with great reviews.",
    ],
  },
  {
    title: "Dress Code",
    items: [
      "Semi-formal — suits, dresses, cocktail attire.",
      "Outdoor ceremony: choose comfortable shoes.",
    ],
  },
  {
    title: "Schedule Summary",
    items: [
      "2:00 PM — Ceremony",
      "2:30 PM — Cocktail Hour",
      "3:30 PM — Dinner",
      "6:00 PM — First Dance & Party",
    ],
  },
  {
    title: "Venue Notes",
    items: [
      ceremonyVenue?.data.notes || "Ceremony venue information",
      receptionVenue?.data.notes || "Reception venue information",
    ],
  },
  {
    title: "Venue Notes",
    items: [
      ceremonyVenue?.data.notes || "Ceremony venue information",
      receptionVenue?.data.notes || "Reception venue information",
    ],
  },
  {
    title: "Special Instructions",
    items: [
      "Please turn phones on silent during the ceremony.",
      "No flash photography.",
    ],
  },
  {
    title: "Food & Allergies",
    items: [
      "Please list allergies in your RSVP.",
      "Vegetarian options available.",
    ],
  },
  {
    title: "Local Tips",
    items: [
      "The park has amazing sunset views — perfect for photos.",
      "The lakeside café is great for breakfast the next day.",
    ],
  },
];
---

<BaseLayout>
  <section>
    <Wrapper variant="wide" class="pt-24 lg:pt-32">
      <Image
        src={info}
        alt="info"
        width="1440"
        height="1193"
        loading="eager"
        decoding="async"
        class="w-full max-h-100 object-cover object-center saturate-50"
      />
    </Wrapper>
    <Wrapper variant="standard" class="py-24">
      <div class="space-y-10">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
          <div>
            <div class="lg:sticky lg:top-32 lg:text-balance">
              <Text
                tag="h1"
                variant="displayLG"
                class="text-base-900 font-serif font-light leading-snug tracking-tight"
                >Info</Text
              >
              <Text tag="p" variant="textBase" class="text-base-600 mt-2"
                >Answers to common questions about the day.</Text
              >
              <div class="mt-8 pt-8 border-t border-base-200">
                <Text
                  tag="h3"
                  variant="textLG"
                  class="text-base-900 italic font-serif"
                >
                  Quick Venue Info
                </Text>
                <div class="space-y-4 mt-4">
                  <div>
                    <Text
                      tag="p"
                      variant="textSM"
                      class="text-base-900 font-medium"
                    >
                      Ceremony
                    </Text>
                    <Text tag="p" variant="textSM" class="text-base-600 mt-2">
                      {ceremonyVenue?.data.name}<br />
                      2:00 PM • {ceremonyVenue?.data.notes}
                    </Text>
                  </div>
                  <div>
                    <Text
                      tag="p"
                      variant="textSM"
                      class="text-base-900 font-medium"
                    >
                      Reception
                    </Text>
                    <Text tag="p" variant="textSM" class="text-base-600 mt-2">
                      {receptionVenue?.data.name}<br />
                      3:30 PM • {receptionVenue?.data.notes}
                    </Text>
                  </div>
                  <div>
                    <Text tag="p" variant="textSM" class="text-base-600">
                      <span class="font-medium text-base-900">Parking:</span> Free
                      at both venues
                    </Text>
                    <Text tag="p" variant="textSM" class="text-base-600 mt-2">
                      <span class="font-medium text-base-900">Dress:</span> Semi-formal,
                      comfortable shoes
                    </Text>
                  </div>
                </div>
                <Text
                  tag="p"
                  variant="textSM"
                  class="text-base-500 italic mt-6"
                >
                  See maps and full details below ↓
                </Text>
              </div>
            </div>
          </div>

          <div class="space-y-24 lg:col-span-2">
            {
              infoSections.map((section) => (
                <section class="space-y-2 border-b border-base-200 pb-4">
                  <Text
                    tag="h3"
                    variant="textXL"
                    class="text-base-900 font-serif "
                  >
                    {section.title}
                  </Text>
                  <ul class="list-disc space-y-1 mt-8 list-none">
                    {section.items.map((item) => (
                      <li>
                        <Text tag="p" variant="textBase" class="text-base-600">
                          {item}
                        </Text>
                      </li>
                    ))}
                  </ul>
                  {section.maps && (
                    <div class="mt-6 grid grid-cols-1 lg:grid-cols-2 gap-4">
                      {section.maps.map((map) => (
                        <div class="">
                          <div>
                            <Text
                              tag="h4"
                              variant="textBase"
                              class="text-base-900 font-serif"
                            >
                              {map.title}
                            </Text>
                            <Text
                              tag="p"
                              variant="textXS"
                              class="text-base-500"
                            >
                              {map.address}
                            </Text>
                          </div>
                          <iframe
                            src={map.embedUrl}
                            width="100%"
                            height="300"
                            style="border:0;"
                            allowfullscreen=""
                            loading="lazy"
                            referrerpolicy="no-referrer-when-downgrade"
                            class="rounded-lg mt-8"
                          />
                        </div>
                      ))}
                    </div>
                  )}
                </section>
              ))
            }
          </div>
        </div>
      </div>
    </Wrapper>
  </section>
</BaseLayout>
