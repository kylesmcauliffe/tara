---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import FramedButton from "@/components/tara/FramedButton.astro";
---

<BaseLayout>
  <section class="pt-14 pb-20 lg:pt-20 lg:pb-28">
    <Wrapper variant="wide" class="max-w-md mx-auto">
      <div class="text-center mb-10">
        <p class="text-[11px] tracking-[0.28em] uppercase text-charcoal/50">
          Assistance
        </p>
        <h1 class="mt-3 font-script text-4xl md:text-5xl text-charcoal tara-fade-in">
          Track Order
        </h1>
        <p class="mt-3 text-sm text-charcoal/65 font-serif">
          Enter your order number and email to view status.
        </p>
      </div>

      <form id="track-form" class="space-y-5">
        <div>
          <label
            for="order-number"
            class="block text-[11px] tracking-[0.18em] uppercase text-charcoal/55 mb-2"
          >
            Order Number
          </label>
          <input
            id="order-number"
            name="order"
            type="text"
            required
            class="w-full bg-transparent border border-charcoal/40 px-4 py-3 text-sm font-serif focus:border-charcoal focus:ring-0"
          />
        </div>
        <div>
          <label
            for="order-email"
            class="block text-[11px] tracking-[0.18em] uppercase text-charcoal/55 mb-2"
          >
            Email
          </label>
          <input
            id="order-email"
            name="email"
            type="email"
            required
            class="w-full bg-transparent border border-charcoal/40 px-4 py-3 text-sm font-serif focus:border-charcoal focus:ring-0"
          />
        </div>
        <FramedButton type="submit" class="w-full">Look Up</FramedButton>
        <p
          id="track-note"
          class="hidden text-center text-sm text-charcoal/60 font-serif"
        >
          Order tracking connects once fulfillment is live. For help now,
          <a href="/contact" class="underline underline-offset-4">contact us</a>.
        </p>
      </form>
    </Wrapper>
  </section>
</BaseLayout>

<script>
  document.getElementById("track-form")?.addEventListener("submit", (e) => {
    e.preventDefault();
    document.getElementById("track-note")?.classList.remove("hidden");
  });
</script>
