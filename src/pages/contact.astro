---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import FramedButton from "@/components/tara/FramedButton.astro";
---

<BaseLayout>
  <section class="pt-14 pb-20 lg:pt-20 lg:pb-28">
    <Wrapper variant="wide" class="max-w-xl mx-auto">
      <div class="text-center mb-10">
        <p class="text-[11px] tracking-[0.28em] uppercase text-charcoal/50">
          Assistance
        </p>
        <h1 class="mt-3 font-script text-4xl md:text-5xl text-charcoal tara-fade-in">
          Contact
        </h1>
        <p class="mt-3 text-sm text-charcoal/65 font-serif">
          We typically reply within one to two business days.
        </p>
      </div>

      <form
        name="contact"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        class="space-y-5"
      >
        <input type="hidden" name="form-name" value="contact" />
        <p class="hidden">
          <label>Don’t fill this out: <input name="bot-field" /></label>
        </p>
        <div>
          <label
            for="contact-name"
            class="block text-[11px] tracking-[0.18em] uppercase text-charcoal/55 mb-2"
          >
            Name
          </label>
          <input
            id="contact-name"
            name="name"
            type="text"
            required
            class="w-full bg-transparent border border-charcoal/40 px-4 py-3 text-sm font-serif focus:border-charcoal focus:ring-0"
          />
        </div>
        <div>
          <label
            for="contact-email"
            class="block text-[11px] tracking-[0.18em] uppercase text-charcoal/55 mb-2"
          >
            Email
          </label>
          <input
            id="contact-email"
            name="email"
            type="email"
            required
            class="w-full bg-transparent border border-charcoal/40 px-4 py-3 text-sm font-serif focus:border-charcoal focus:ring-0"
          />
        </div>
        <div>
          <label
            for="contact-message"
            class="block text-[11px] tracking-[0.18em] uppercase text-charcoal/55 mb-2"
          >
            Message
          </label>
          <textarea
            id="contact-message"
            name="message"
            rows="5"
            required
            class="w-full bg-transparent border border-charcoal/40 px-4 py-3 text-sm font-serif focus:border-charcoal focus:ring-0"
          ></textarea>
        </div>
        <FramedButton type="submit" class="w-full">Send Message</FramedButton>
      </form>

      <div class="mt-12 text-center text-sm text-charcoal/65 font-serif space-y-1">
        <p>
          <a href="mailto:hello@tara.example" class="hover:opacity-60"
            >hello@tara.example</a
          >
        </p>
        <p>
          Or visit
          <a href="/shops" class="underline underline-offset-4 hover:opacity-60"
            >our shops</a
          >
        </p>
      </div>
    </Wrapper>
  </section>
</BaseLayout>
