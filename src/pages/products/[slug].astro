---
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import FramedButton from "@/components/tara/FramedButton.astro";
import ProductCard from "@/components/tara/ProductCard.astro";
import {
  products,
  sizes,
  formatPrice,
  getProduct,
} from "@/data/tara";
import { getTaraImage } from "@/data/images";

export function getStaticPaths() {
  return products.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const product = getProduct(slug!);
if (!product) {
  return Astro.redirect("/shop");
}

const lookProducts = (product.completeTheLook ?? [])
  .map((s) => getProduct(s))
  .filter(Boolean);
---

<BaseLayout>
  <section class="py-10 lg:py-16">
    <Wrapper variant="wide">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-start">
        <div class="tara-frame-thin overflow-hidden bg-taupe/30 aspect-[3/4] tara-fade-in">
          <Image
            src={getTaraImage(product.imageKey)}
            alt={product.name}
            class="size-full object-cover"
            widths={[640, 960, 1200]}
            sizes="(max-width: 1024px) 100vw, 50vw"
            loading="eager"
          />
        </div>

        <div class="lg:pt-6 tara-fade-in-delay" data-pdp>
          <p class="text-[11px] tracking-[0.2em] uppercase text-charcoal/55">
            {product.subtitle}
          </p>
          <h1 class="mt-2 font-serif text-3xl md:text-4xl tracking-wide text-charcoal">
            {product.name}
          </h1>
          <p class="mt-3 text-lg text-charcoal/80">{formatPrice(product.price)}</p>

          <div class="mt-10">
            <p class="text-[11px] tracking-[0.2em] uppercase text-charcoal/55 mb-4">
              Select Size
            </p>
            <div class="flex flex-wrap gap-2" role="listbox" aria-label="Size">
              {
                sizes.map((size) => (
                  <button
                    type="button"
                    class="size-btn min-w-11 h-11 px-2 border border-charcoal/25 text-[11px] tracking-wider uppercase hover:border-charcoal transition-colors data-[selected=true]:border-charcoal data-[selected=true]:bg-charcoal data-[selected=true]:text-cream"
                    data-size={size}
                    data-selected="false"
                  >
                    {size}
                  </button>
                ))
              }
            </div>
            <p
              id="size-hint"
              class="mt-3 text-sm text-charcoal/50 hidden"
              data-size-hint
            >
              Please select a size.
            </p>
          </div>

          <div class="mt-8">
            <FramedButton
              type="button"
              class="w-full sm:w-auto min-w-[14rem]"
              id="add-to-bag"
            >
              Add to Bag
            </FramedButton>
          </div>

          <script
            type="application/json"
            id="pdp-product"
            set:html={JSON.stringify({
              slug: product.slug,
              name: product.name,
              price: product.price,
              imageKey: product.imageKey,
            })}
          />

          <div class="mt-12 border-t border-taupe pt-8" data-pdp-tabs>
            <div class="flex flex-wrap gap-6 md:gap-8 border-b border-taupe">
              <button
                type="button"
                class="tab-btn pb-3 text-[11px] tracking-[0.2em] uppercase border-b-2 border-charcoal -mb-px"
                data-tab="description"
                aria-selected="true"
              >
                Description
              </button>
              <button
                type="button"
                class="tab-btn pb-3 text-[11px] tracking-[0.2em] uppercase border-b-2 border-transparent text-charcoal/50 -mb-px"
                data-tab="details"
                aria-selected="false"
              >
                Details
              </button>
              <button
                type="button"
                class="tab-btn pb-3 text-[11px] tracking-[0.2em] uppercase border-b-2 border-transparent text-charcoal/50 -mb-px"
                data-tab="size-fit"
                aria-selected="false"
              >
                Size &amp; Fit
              </button>
            </div>
            <div class="mt-6 text-base leading-relaxed text-charcoal/80 font-serif">
              <p data-panel="description">{product.description}</p>
              <p data-panel="details" class="hidden">{product.details}</p>
              <p data-panel="size-fit" class="hidden">{product.sizeFit}</p>
            </div>
          </div>
        </div>
      </div>
    </Wrapper>
  </section>

  {
    lookProducts.length > 0 && (
      <section class="pb-20 lg:pb-28 border-t border-taupe pt-16">
        <Wrapper variant="wide">
          <div class="text-center mb-12">
            <p class="text-[11px] tracking-[0.28em] uppercase text-charcoal/50">
              Style with
            </p>
            <h2 class="mt-2 font-script text-3xl md:text-4xl text-charcoal">
              Complete the Look
            </h2>
          </div>
          <div class="grid grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8 max-w-4xl mx-auto">
            {lookProducts.map(
              (p) =>
                p && (
                  <ProductCard
                    name={p.name}
                    subtitle={p.subtitle}
                    price={p.price}
                    href={`/products/${p.slug}`}
                    image={getTaraImage(p.imageKey)}
                  />
                ),
            )}
          </div>
        </Wrapper>
      </section>
    )
  }
</BaseLayout>

<script>
  import { addToCart, openCart } from "@/scripts/cart";

  let selectedSize: string | null = null;

  document.querySelectorAll(".size-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      document.querySelectorAll(".size-btn").forEach((b) => {
        (b as HTMLElement).dataset.selected = "false";
      });
      (btn as HTMLElement).dataset.selected = "true";
      selectedSize = (btn as HTMLElement).dataset.size ?? null;
      document.querySelector("[data-size-hint]")?.classList.add("hidden");
    });
  });

  const tabsRoot = document.querySelector("[data-pdp-tabs]");
  if (tabsRoot) {
    const buttons = tabsRoot.querySelectorAll(".tab-btn");
    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const tab = (btn as HTMLElement).dataset.tab;
        buttons.forEach((b) => {
          const el = b as HTMLElement;
          const active = el.dataset.tab === tab;
          el.setAttribute("aria-selected", String(active));
          el.classList.toggle("border-charcoal", active);
          el.classList.toggle("border-transparent", !active);
          el.classList.toggle("text-charcoal/50", !active);
        });
        tabsRoot.querySelectorAll("[data-panel]").forEach((panel) => {
          const el = panel as HTMLElement;
          el.classList.toggle("hidden", el.dataset.panel !== tab);
        });
      });
    });
  }

  const addBtn = document.getElementById("add-to-bag");
  const productEl = document.getElementById("pdp-product");
  addBtn?.addEventListener("click", () => {
    if (!selectedSize) {
      document.querySelector("[data-size-hint]")?.classList.remove("hidden");
      return;
    }
    if (!productEl?.textContent) return;
    const product = JSON.parse(productEl.textContent) as {
      slug: string;
      name: string;
      price: number;
      imageKey: string;
    };
    addToCart({
      slug: product.slug,
      name: product.name,
      price: product.price,
      size: selectedSize,
      imageKey: product.imageKey,
    });
    openCart();
  });
</script>
