---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

const faqs = [
  {
    q: "How do I find my size?",
    a: "Each product page includes Size & Fit notes. When in doubt, visit a shop or email us with your usual size and preferred fit.",
  },
  {
    q: "How long does shipping take?",
    a: "US orders typically arrive within 3–7 business days. You’ll receive tracking once the package leaves our studio.",
  },
  {
    q: "Can I return an item?",
    a: "Unworn pieces with tags may be returned within 14 days. See our Returns page for details.",
  },
  {
    q: "Do you ship internationally?",
    a: "We currently ship within the United States. International shipping may return in a future season.",
  },
  {
    q: "How do gift cards work?",
    a: "Digital cards arrive by email; physical cards ship in a cream envelope. Both redeem online and in our shops.",
  },
];
---

<BaseLayout>
  <section class="pt-14 pb-20 lg:pt-20 lg:pb-28">
    <Wrapper variant="wide" class="max-w-2xl mx-auto">
      <div class="text-center mb-12">
        <p class="text-[11px] tracking-[0.28em] uppercase text-charcoal/50">
          Assistance
        </p>
        <h1 class="mt-3 font-script text-4xl md:text-5xl text-charcoal tara-fade-in">
          FAQ
        </h1>
      </div>
      <dl class="space-y-8">
        {
          faqs.map((item) => (
            <div class="border-b border-taupe pb-8">
              <dt class="text-[12px] tracking-[0.16em] uppercase text-charcoal">
                {item.q}
              </dt>
              <dd class="mt-3 text-base text-charcoal/70 leading-relaxed font-serif">
                {item.a}
              </dd>
            </div>
          ))
        }
      </dl>
      <p class="mt-12 text-center text-sm text-charcoal/60 font-serif">
        Still need help?
        <a href="/contact" class="underline underline-offset-4 hover:opacity-60"
          >Contact us</a
        >
      </p>
    </Wrapper>
  </section>
</BaseLayout>
