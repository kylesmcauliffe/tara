---
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Content
import { getCollection } from "astro:content";
const allPosts = await getCollection("posts");
const tags = [...new Set(allPosts.map((post) => post.data.tags).flat())];
const pageTitle = "Tag Index";
---

<BaseLayout pageTitle={pageTitle}>
  <section>
    <Wrapper variant="standard" class="py-24 lg:pt-32">
      <Text
        tag="h1"
        variant="displayLG"
        class="text-base-900 font-serif font-light leading-snug tracking-tight"
      >
        Tag directory</Text
      >

      <ul role="list" class="flex flex-col mt-12 gap-1 gap-4">
        {
          tags.map((tag, index) => (
            <li>
              <Text
                tag="a"
                variant="displaySM"
                class="capitalize  text-base-900 font-display hover:Text--base-600 "
                href={`/blog/tags/${tag}`}
              >
                {tag}
              </Text>
            </li>
          ))
        }
      </ul>
    </Wrapper>
  </section>
</BaseLayout>
