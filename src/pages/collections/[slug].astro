---
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import ProductCard from "@/components/tara/ProductCard.astro";
import {
  collections,
  getCollection,
  productsByCollection,
} from "@/data/tara";
import { getTaraImage } from "@/data/images";

export function getStaticPaths() {
  return collections.map((c) => ({ params: { slug: c.slug } }));
}

const { slug } = Astro.params;
const collection = getCollection(slug!);
if (!collection) {
  return Astro.redirect("/collections");
}

const items = productsByCollection(collection.slug);
---

<BaseLayout>
  <section class="relative h-[42svh] md:h-[52svh] overflow-hidden">
    <Image
      src={getTaraImage(collection.imageKey)}
      alt={collection.title}
      class="absolute inset-0 size-full object-cover"
      widths={[800, 1280, 1920]}
      sizes="100vw"
      loading="eager"
    />
    <div class="absolute inset-0 bg-black/30"></div>
    <div
      class="absolute inset-0 flex flex-col items-center justify-center text-center px-6"
    >
      <p class="text-[11px] tracking-[0.28em] uppercase text-white/85">
        Collection
      </p>
      <h1 class="mt-3 font-script text-white text-4xl md:text-5xl lg:text-6xl tara-fade-in">
        {collection.title}
      </h1>
    </div>
  </section>

  <section class="pt-12 pb-8 lg:pt-16">
    <Wrapper variant="wide" class="text-center max-w-2xl mx-auto">
      <p class="text-base md:text-lg text-charcoal/70 leading-relaxed font-serif">
        {collection.description}
      </p>
    </Wrapper>
  </section>

  <section class="pb-20 lg:pb-28">
    <Wrapper variant="wide">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8">
        {
          items.map((product) => (
            <ProductCard
              name={product.name}
              subtitle={product.subtitle}
              price={product.price}
              href={`/products/${product.slug}`}
              image={getTaraImage(product.imageKey)}
            />
          ))
        }
      </div>
    </Wrapper>
  </section>
</BaseLayout>
