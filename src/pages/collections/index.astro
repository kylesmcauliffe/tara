---
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import ProductCard from "@/components/tara/ProductCard.astro";
import FramedButton from "@/components/tara/FramedButton.astro";
import { collections } from "@/data/tara";
import { getTaraImage } from "@/data/images";
---

<BaseLayout>
  <section class="pt-14 pb-10 lg:pt-20 lg:pb-14">
    <Wrapper variant="wide" class="text-center max-w-2xl mx-auto">
      <p class="text-[11px] tracking-[0.28em] uppercase text-charcoal/50">
        Collections
      </p>
      <h1
        class="mt-3 font-script text-4xl md:text-5xl lg:text-6xl text-charcoal tara-fade-in"
      >
        Seasonal Chapters
      </h1>
      <p class="mt-4 text-base md:text-lg text-charcoal/70 leading-relaxed font-serif">
        Edited stories for the season—soft structure, quiet color, and pieces
        meant to be worn often.
      </p>
    </Wrapper>
  </section>

  <section class="pb-20 lg:pb-28">
    <Wrapper variant="wide">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-10 lg:gap-14">
        {
          collections.map((collection) => (
            <article class="group">
              <a
                href={`/collections/${collection.slug}`}
                class="block relative overflow-hidden aspect-[4/5] mb-6"
              >
                <Image
                  src={getTaraImage(collection.imageKey)}
                  alt={collection.title}
                  class="absolute inset-0 size-full object-cover tara-img-zoom"
                  widths={[640, 960]}
                  sizes="(max-width: 768px) 100vw, 50vw"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-black/15 group-hover:bg-black/25 transition-colors duration-400" />
              </a>
              <div class="text-center max-w-md mx-auto">
                <h2 class="font-script text-3xl md:text-4xl text-charcoal">
                  {collection.title}
                </h2>
                <p class="mt-3 text-sm text-charcoal/65 leading-relaxed font-serif">
                  {collection.description}
                </p>
                <div class="mt-6">
                  <FramedButton href={`/collections/${collection.slug}`}>
                    Shop the Collection
                  </FramedButton>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </Wrapper>
  </section>
</BaseLayout>
