---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import FramedButton from "@/components/tara/FramedButton.astro";
---

<BaseLayout>
  <section class="pt-20 pb-28 lg:pt-28 lg:pb-36">
    <Wrapper variant="wide" class="max-w-lg mx-auto text-center">
      <p class="text-[11px] tracking-[0.28em] uppercase text-charcoal/50">
        Checkout
      </p>
      <h1 class="mt-3 font-script text-4xl md:text-5xl text-charcoal tara-fade-in">
        Checkout Cancelled
      </h1>
      <p class="mt-4 text-base text-charcoal/70 leading-relaxed font-serif">
        Your bag is still waiting. No charge was made.
      </p>
      <div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center">
        <FramedButton href="/shop">Return to Shop</FramedButton>
        <button
          type="button"
          id="reopen-bag"
          class="tara-frame px-8 py-3 text-[11px] tracking-[0.22em] uppercase tara-hover-fade"
        >
          Open Bag
        </button>
      </div>
    </Wrapper>
  </section>
</BaseLayout>

<script>
  import { openCart } from "@/scripts/cart";
  document.getElementById("reopen-bag")?.addEventListener("click", () => {
    openCart();
  });
</script>
